        "corner_radius": 4,
    },
    "CTkCheckBox": {
        "fg_color": [ACCENT, ACCENT],
        "hover_color": [ACCENT_HOVER, ACCENT_HOVER],
        "border_color": [BORDER_ACTIVE, BORDER_ACTIVE],
