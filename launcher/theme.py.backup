"""
FractalLauncher UI Theme — Lunar Client / Feather inspired dark aesthetic.
"""

# ── Palette ───────────────────────────────────────────────────────────────────
BG_DARK        = "#0d0f13"
BG_PANEL       = "#13161c"
BG_CARD        = "#181c24"
BG_INPUT       = "#1e2230"
BG_HOVER       = "#232840"
ACCENT         = "#5865f2"   # Electric blue-purple
ACCENT_HOVER   = "#6d7af5"
ACCENT_DARK    = "#3d4dbf"
SUCCESS        = "#3ba55d"
SUCCESS_HOVER  = "#4cc870"
DANGER         = "#ed4245"
WARN           = "#faa61a"
TEXT_PRIMARY   = "#e8eaf6"
TEXT_SECONDARY = "#8b92a5"
TEXT_MUTED     = "#555e78"
BORDER         = "#252a38"
BORDER_ACTIVE  = "#3d4566"
SCROLLBAR      = "#2a2f42"

# ── Typography ────────────────────────────────────────────────────────────────
FONT_FAMILY    = "Segoe UI"   # Falls back gracefully on all platforms
FONT_TITLE     = (FONT_FAMILY, 22, "bold")
FONT_HEADING   = (FONT_FAMILY, 13, "bold")
FONT_SUBHEAD   = (FONT_FAMILY, 11, "bold")
FONT_BODY      = (FONT_FAMILY, 11)
FONT_SMALL     = (FONT_FAMILY, 10)
FONT_TINY      = (FONT_FAMILY, 9)
FONT_MONO      = ("Consolas", 10)   # Console output

# ── Geometry ──────────────────────────────────────────────────────────────────
WIN_W          = 1050
WIN_H          = 680
SIDEBAR_W      = 220
CORNER_RADIUS  = 10
BTN_RADIUS     = 8
CARD_RADIUS    = 10
PAD            = 16
PAD_SM         = 8
PAD_XS         = 4

# ── customtkinter appearance ──────────────────────────────────────────────────
CTK_THEME = {
    "CTk": {
        "fg_color": [BG_DARK, BG_DARK],
    },
