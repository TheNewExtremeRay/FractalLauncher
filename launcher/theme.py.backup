        "button_hover_color": [TEXT_PRIMARY, TEXT_PRIMARY],
        "text_color": [TEXT_PRIMARY, TEXT_PRIMARY],
    },
    "CTkTabview": {
        "fg_color": [BG_PANEL, BG_PANEL],
        "segmented_button_fg_color": [BG_DARK, BG_DARK],
